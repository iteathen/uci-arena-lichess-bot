{
  "schema": "uci_arena_component_definition_v1",
  "component_id": "lichess.adapter",
  "package_json": "package.json",
  "component_manifest": "contracts/component-manifest.json",
  "source_repository": "iteathen/uci-arena-lichess-bot",
  "native_toolchain_by_target": {
    "windows-x86_64": {
      "receipt_schema": "arena_native_toolchain_receipt_v1",
      "build_system": "cmake",
      "language": "cxx"
    }
  },
  "include": [
    {"source": "backfill-game-provenance.mjs", "target": "backfill-game-provenance.mjs"},
    {"source": "chess-legality.mjs", "target": "chess-legality.mjs"},
    {"source": "continuous-game-qualification.mjs", "target": "continuous-game-qualification.mjs"},
    {"source": "continuous-uci-observation.mjs", "target": "continuous-uci-observation.mjs"},
    {"source": "config.uci_arena.template.yml", "target": "config.uci_arena.template.yml"},
    {"source": "contracts", "target": "contracts"},
    {"source": "exact-file.mjs", "target": "exact-file.mjs"},
    {"source": "lichess-adapter.mjs", "target": "lichess-adapter.mjs"},
    {"source": "provider-incidents.mjs", "target": "provider-incidents.mjs"},
    {"source": "provider-games.mjs", "target": "provider-games.mjs"},
    {"source": "lichess-scheduler.mjs", "target": "lichess-scheduler.mjs"},
    {"source": "lichess-storage.mjs", "target": "lichess-storage.mjs"},
    {"source": "lichess-store.mjs", "target": "lichess-store.mjs"},
    {"source": "process-instance-identity.mjs", "target": "process-instance-identity.mjs"},
    {"source": "provider-lifecycle-diagnostics.mjs", "target": "provider-lifecycle-diagnostics.mjs"},
    {"source": "provider-maintenance.mjs", "target": "provider-maintenance.mjs"},
    {"source": "offline-workspace-restore.mjs", "target": "offline-workspace-restore.mjs"},
    {"source": "provider-replacement-state.mjs", "target": "provider-replacement-state.mjs"},
    {"source": "runtime-status-publisher.mjs", "target": "runtime-status-publisher.mjs"},
    {"source": "runtime-status-worker.mjs", "target": "runtime-status-worker.mjs"},
    {"source": "installer-integration.mjs", "target": "installer-integration.mjs"},
    {"source": "linux-startup.mjs", "target": "linux-startup.mjs"},
    {"source": "live-acceptance.mjs", "target": "live-acceptance.mjs"},
    {"source": "publish-single-game-profile.mjs", "target": "publish-single-game-profile.mjs"},
    {"source": "single-game-profile-validation.mjs", "target": "single-game-profile-validation.mjs"},
    {"source": "smoke-uci-startup.mjs", "target": "smoke-uci-startup.mjs"},
    {"source": "vendor/time-profile-contract/package.json", "target": "vendor/time-profile-contract/package.json"},
    {"source": "vendor/time-profile-contract/src", "target": "vendor/time-profile-contract/src"},
    {"source": "vendor/background-service-runtime/package.json", "target": "vendor/background-service-runtime/package.json"},
    {"source": "vendor/background-service-runtime/src", "target": "vendor/background-service-runtime/src"},
    {"source": "windows-startup.mjs", "target": "windows-startup.mjs"},
    {"source": "README.md", "target": "README.md"}
  ],
  "native_launcher": {
    "windows-x86_64": {
      "required": true,
      "target": "native/lichess_adapter_launcher.exe"
    },
    "linux-x86_64": {
      "required": false
    }
  },
  "native_process_query": {
    "windows-x86_64": { "required": true, "target": "native/uci_arena_background_guard.exe" },
    "linux-x86_64": { "required": false }
  },
  "required_test_suites": [
    "npm run check"
  ]
}
