{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uci_arena_provider_game_page_v1",
  "title": "UCI Arena Provider Game Page",
  "type": "object",
  "required": ["schema", "scope", "before_cursor", "next_cursor", "has_more", "games"],
  "properties": {
    "schema": {"const": "uci_arena_provider_game_page_v1"},
    "scope": {"enum": ["live", "history"]},
    "before_cursor": {"$ref": "#/$defs/nonnegative_integer"},
    "next_cursor": {"$ref": "#/$defs/nonnegative_integer"},
    "has_more": {"type": "boolean"},
    "games": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/game_summary"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullable_nonnegative_integer": {
      "oneOf": [
        {"$ref": "#/$defs/nonnegative_integer"},
        {"type": "null"}
      ]
    },
    "nullable_token": {
      "oneOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,128}$"},
        {"type": "null"}
      ]
    },
    "nullable_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "component": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["component_id", "version", "manifest_sha256"],
          "properties": {
            "component_id": {"type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,128}$"},
            "version": {"type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,128}$"},
            "manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "game_summary": {
      "type": "object",
      "required": [
        "cursor", "game_id", "state", "opponent", "color", "rated", "speed", "variant",
        "clock_limit", "clock_increment", "status", "result", "winner", "plies",
        "started_at", "finished_at", "archive_completeness", "incomplete_reason",
        "archive_sha256", "provider_component", "engine_component"
      ],
      "properties": {
        "cursor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "game_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "state": {"enum": ["live", "history"]},
        "opponent": {"type": "string", "maxLength": 32},
        "color": {"oneOf": [{"enum": ["white", "black"]}, {"type": "null"}]},
        "rated": {"type": "boolean"},
        "speed": {"$ref": "#/$defs/nullable_token"},
        "variant": {"const": "standard"},
        "clock_limit": {"$ref": "#/$defs/nonnegative_integer"},
        "clock_increment": {"$ref": "#/$defs/nonnegative_integer"},
        "status": {"type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,128}$"},
        "result": {"$ref": "#/$defs/nullable_token"},
        "winner": {"$ref": "#/$defs/nullable_token"},
        "plies": {"type": "integer", "minimum": 0, "maximum": 2048},
        "started_at": {"$ref": "#/$defs/nonnegative_integer"},
        "finished_at": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "archive_completeness": {"enum": ["live", "summary_only", "complete", "reconciled"]},
        "incomplete_reason": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
            {"type": "null"}
          ]
        },
        "archive_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "provider_component": {"$ref": "#/$defs/component"},
        "engine_component": {"$ref": "#/$defs/component"}
      },
      "additionalProperties": false
    }
  }
}
