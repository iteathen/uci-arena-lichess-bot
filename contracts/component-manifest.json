{
  "schema": "uci_arena_component_manifest_v1",
  "component": {
    "id": "lichess.adapter",
    "product_id": "uci_arena.lichess_bot",
    "version": "1.0.36",
    "repository": "iteathen/uci-arena-lichess-bot"
  },
  "runtime": {
    "entrypoint": "lichess-adapter.mjs",
    "working_directory": ".",
    "runtime_requirement": "node >=24.15.0",
    "health_checks": [
      {
        "type": "typed_cli_json",
        "arguments": ["status"],
        "expected": {"schema": "uci_arena_lichess_status_v5", "installed": true},
        "credential_required": false
      }
    ]
  },
  "installation": {
    "install_manifest_schema": "arena_install_component_v1",
    "contract_manifest": "contracts/service-contract.json",
    "entrypoints": {
      "adapter": "lichess-adapter.mjs",
      "cli": "lichess-adapter.mjs",
      "installer_integration": "installer-integration.mjs",
      "startup": "lichess-adapter.mjs",
      "live_acceptance": "live-acceptance.mjs",
      "uci_smoke": "smoke-uci-startup.mjs"
    },
    "capabilities": [
      "manager_operations",
      "provider_configuration",
      "provider_status",
      "provider_incidents",
      "provider_games",
      "installed_qualification",
      "startup_install",
      "startup_recover",
      "startup_uninstall"
    ],
    "dependencies": ["node_runtime.private"],
    "startup": {
      "windows": "per_user_task_scheduler",
      "linux": "per_user_systemd",
      "credential_gated": true
    },
    "data_paths": ["workspace"],
    "workspace_name": "lichess-adapter",
    "installer_integration": {
      "schema": "arena_provider_installer_integration_v1",
      "schema_version": 1,
      "entrypoint": "installer_integration",
      "invocation": {
        "kind": "dependency_runtime",
        "runtime_component_id": "node_runtime.private",
        "runtime_entrypoint": "node"
      },
      "arguments": ["--context"],
      "workspace_name": "lichess-adapter",
      "configure_when_disabled": true,
      "dependency_bindings": [
        {"name": "default_engine", "component_id": "uci_arena.engine", "source": "entrypoint", "entrypoint": "uci", "required": false},
        {"name": "default_engine_root", "component_id": "uci_arena.engine", "source": "active_root", "required": false},
        {"name": "default_engine_manifest", "component_id": "uci_arena.engine", "source": "component_path", "path": "arena-component.json", "required": false},
        {"name": "default_model_root", "component_id": "uci_arena.engine", "source": "component_path", "path": "models/default", "required": false},
        {"name": "complete_game_entrypoint", "component_id": "uci_arena_evidence.runtime", "source": "entrypoint", "entrypoint": "complete_game", "required": false},
        {"name": "referee", "component_id": "uci_arena_evidence.runtime", "source": "entrypoint", "entrypoint": "referee", "required": false},
        {"name": "stockfish", "component_id": "stockfish.engine", "source": "entrypoint", "entrypoint": "stockfish", "required": false}
      ],
      "locator_bindings": [
        {"name": "uci_engine", "kind": "uci_engine", "required": false, "accepted_sources": ["saved_locator"]},
        {"name": "timing_profile", "kind": "timing_profile", "required": false, "accepted_sources": ["saved_locator"]},
        {"name": "lichess_single_game_profile", "kind": "lichess_single_game_profile", "required": false, "accepted_sources": ["saved_locator"]},
        {"name": "lichess_capacity_profile", "kind": "lichess_capacity_profile", "required": false, "accepted_sources": ["saved_locator"]},
        {"name": "lichess_transport_profile", "kind": "lichess_transport_profile", "required": false, "accepted_sources": ["saved_locator"]},
        {"name": "opening_book", "kind": "opening_book", "required": false, "accepted_sources": ["saved_locator", "install_receipt"]},
        {"name": "syzygy", "kind": "syzygy", "required": false, "accepted_sources": ["saved_locator", "install_receipt"]}
      ],
      "startup_control": {
        "schema": "arena_provider_startup_control_v2",
        "schema_version": 2,
        "entrypoint": "startup",
        "actions": {
          "install": ["startup", "install"],
          "uninstall": ["startup", "uninstall"],
          "pre_replace": ["startup", "prepare_replace"],
          "post_replace": ["startup", "complete_replace"]
        },
        "replacement_arguments": {
          "previous_root": "--previous-root",
          "replacement_root": "--replacement-root"
        },
        "workspace_argument": {"flag": "--runtime-dir", "relative_path": "."},
        "configuration_argument": "--config",
        "result": {
          "envelope": "startup",
          "require_configuration_match_on_install": false,
          "require_live_on_install": false,
          "require_live_on_post_replace": false,
          "allow_deferred_requalification_on_post_replace": true
        }
      }
    },
    "configuration_template": "config.uci_arena.template.yml",
    "owned_paths": [
      "*.mjs",
      "config.uci_arena.template.yml",
      "contracts",
      "native",
      "node_modules",
      "package.json",
      "package-lock.json",
      "README.md",
      "vendor"
    ],
    "preserved_paths": [],
    "optional_paths": ["native/lichess_adapter_launcher.exe"],
    "generated_paths": [],
    "external_user_data": ["provider_workspace"],
    "external_credentials": ["operator_selected_token_file"],
    "uninstall_preserves_user_data": true
  },
  "contracts": {
    "service": "contracts/service-contract.json",
    "configuration": "contracts/configuration-schema.json",
    "configuration_update": "contracts/configuration-update-schema.json",
    "status": "contracts/status-schema.json",
    "incident_page": "contracts/incident-page-schema.json",
    "game_page": "contracts/game-page-schema.json",
    "game_detail": "contracts/game-detail-schema.json",
    "qualification_result": "contracts/qualification-result-schema.json",
    "manager_operations": "contracts/manager-operations-schema.json"
  },
  "compatibility": {
    "manager_api": 1,
    "installer_minimum": "1.3.0",
    "required_components": [],
    "required_capabilities": ["uci.engine.process"],
    "compatible_default_components": ["uci_arena.engine"],
    "optional_components": [
      "opening_book.standard",
      "uci_arena_evidence.runtime",
      "stockfish.engine"
    ]
  }
}
