{
  "schema": "uci_arena_lichess_manager_api_v1",
  "version": "1.3",
  "transport": {
    "kind": "cli_json",
    "entrypoint": "lichess-adapter.mjs",
    "stdout": "one_bounded_json_document",
    "stderr": "sanitized_diagnostics",
    "shell": false
  },
  "operations": {
    "workspace_restore": {
      "arguments": ["workspace", "restore"],
      "required_arguments": ["--source-workspace", "--runtime-dir"],
      "optional_arguments": ["--maximum-milliseconds"],
      "mutates": true, "credential": "forbidden",
      "response": "uci_arena_lichess_workspace_restore_v1",
      "response_schema": "contracts/workspace-restore-schema.json"
    },
    "maintenance_recover": {
      "arguments": ["maintenance", "recover"],
      "required_arguments": ["--config", "--token-file", "--expected-account"],
      "optional_arguments": ["--runtime-dir", "--store", "--engine-root", "--maximum-milliseconds"],
      "mutates": true,
      "credential": "external_file_path_only",
      "response": "uci_arena_lichess_maintenance_recovery_v1",
      "response_schema": "contracts/maintenance-recovery-schema.json"
    },
    "config_get": {
      "arguments": ["config", "get"],
      "mutates": false,
      "credential": "forbidden",
      "response": "uci_arena_lichess_manager_options_v1"
    },
    "config_update": {
      "arguments": ["config", "update"],
      "mutates": true,
      "credential": "forbidden",
      "request": "contracts/configuration-update-schema.json",
      "response": "uci_arena_lichess_manager_options_v1"
    },
    "owner_list": {
      "arguments": ["owner", "list"],
      "mutates": false,
      "credential": "forbidden"
    },
    "owner_add": {
      "arguments": ["owner", "add"],
      "mutates": true,
      "credential": "forbidden"
    },
    "owner_remove": {
      "arguments": ["owner", "remove"],
      "mutates": true,
      "credential": "forbidden"
    },
    "reservation_create": {
      "arguments": ["reserve"],
      "mutates": true,
      "credential": "forbidden"
    },
    "reservation_status": {
      "arguments": ["reservation", "status"],
      "mutates": false,
      "credential": "forbidden"
    },
    "reservation_cancel": {
      "arguments": ["reservation", "cancel"],
      "mutates": true,
      "credential": "forbidden"
    },
    "scheduler_status": {
      "arguments": ["scheduler", "status"],
      "mutates": false,
      "credential": "forbidden"
    },
    "scheduler_pause": {
      "arguments": ["scheduler", "pause"],
      "mutates": true,
      "credential": "forbidden"
    },
    "scheduler_resume": {
      "arguments": ["scheduler", "resume"],
      "mutates": true,
      "credential": "forbidden"
    },
    "startup_status": {
      "arguments": ["startup", "status"],
      "mutates": false,
      "credential": "forbidden"
    },
    "startup_install": {
      "arguments": ["startup", "install"],
      "mutates": true,
      "credential": "external_file_path_only"
    },
    "startup_recover": {
      "arguments": ["startup", "recover"],
      "mutates": true,
      "credential": "forbidden"
    },
    "startup_uninstall": {
      "arguments": ["startup", "uninstall"],
      "mutates": true,
      "credential": "forbidden"
    },
    "provider_status": {
      "arguments": ["status"],
      "mutates": false,
      "credential": "forbidden",
      "response": "uci_arena_lichess_status_v5"
    },
    "incidents_list": {
      "arguments": ["incidents", "list"],
      "optional_arguments": ["--filter", "--after-cursor", "--limit", "--runtime-dir"],
      "mutates": false,
      "credential": "forbidden",
      "response": "uci_arena_provider_incident_page_v1",
      "response_schema": "contracts/incident-page-schema.json"
    },
    "games_list": {
      "arguments": ["games", "list"],
      "optional_arguments": ["--scope", "--before", "--limit", "--runtime-dir"],
      "mutates": false,
      "credential": "forbidden",
      "response": "uci_arena_provider_game_page_v1",
      "response_schema": "contracts/game-page-schema.json"
    },
    "game_get": {
      "arguments": ["game", "get"],
      "required_arguments": ["--game-id"],
      "optional_arguments": ["--runtime-dir"],
      "mutates": false,
      "credential": "forbidden",
      "response": "uci_arena_provider_game_v1",
      "response_schema": "contracts/game-detail-schema.json"
    },
    "qualification_run": {
      "arguments": ["qualification", "run"],
      "mutates": true,
      "credential": "forbidden",
      "response": "uci_arena_lichess_qualification_result_v1",
      "response_schema": "contracts/qualification-result-schema.json"
    },
    "account_probe": {
      "arguments": ["probe"],
      "mutates": false,
      "credential": "external_file_path_only"
    }
  },
  "compatibility": {
    "unknown_operation": "reject",
    "unknown_major": "incompatible",
    "additive_minor_operations": "ignore_until_supported"
  }
}
