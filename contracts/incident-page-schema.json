{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uci_arena_provider_incident_page_v1",
  "title": "UCI Arena Provider Incident Page",
  "type": "object",
  "required": ["schema", "filter", "after_cursor", "next_cursor", "has_more", "incidents", "retention"],
  "properties": {
    "schema": {"const": "uci_arena_provider_incident_page_v1"},
    "filter": {"enum": ["active", "all"]},
    "after_cursor": {"$ref": "#/$defs/nonnegative_integer"},
    "next_cursor": {"$ref": "#/$defs/nonnegative_integer"},
    "has_more": {"type": "boolean"},
    "incidents": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/incident"}
    },
    "retention": {"$ref": "#/$defs/retention"}
  },
  "additionalProperties": false,
  "$defs": {
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullable_nonnegative_integer": {
      "oneOf": [
        {"$ref": "#/$defs/nonnegative_integer"},
        {"type": "null"}
      ]
    },
    "incident": {
      "type": "object",
      "required": [
        "cursor", "code", "severity", "source", "operation", "first_occurrence",
        "last_occurrence", "occurrence_count", "state", "resolved_at", "http_status",
        "retry_deadline", "game_id", "detail"
      ],
      "properties": {
        "cursor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "severity": {"enum": ["info", "warning", "error", "critical"]},
        "source": {"enum": ["api", "scheduler", "stream", "startup", "engine_child", "storage", "status_publication"]},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "first_occurrence": {"$ref": "#/$defs/nonnegative_integer"},
        "last_occurrence": {"$ref": "#/$defs/nonnegative_integer"},
        "occurrence_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "state": {"enum": ["active", "resolved"]},
        "resolved_at": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "http_status": {
          "oneOf": [
            {"type": "integer", "minimum": 100, "maximum": 599},
            {"type": "null"}
          ]
        },
        "retry_deadline": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "game_id": {
          "oneOf": [
            {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
            {"type": "null"}
          ]
        },
        "detail": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$"}
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["maximum_rows", "resolved_retention_ms", "last_truncated_cursor", "truncated_rows", "truncated_active_rows"],
      "properties": {
        "maximum_rows": {"const": 2048},
        "resolved_retention_ms": {"const": 7776000000},
        "last_truncated_cursor": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "truncated_rows": {"$ref": "#/$defs/nonnegative_integer"},
        "truncated_active_rows": {"$ref": "#/$defs/nonnegative_integer"}
      },
      "additionalProperties": false
    }
  }
}
