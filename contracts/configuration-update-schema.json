{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/contracts/lichess-manager-options-update-v1.json",
  "title": "UCI Arena Lichess Bot Manager Options Update",
  "type": "object",
  "required": ["settings"],
  "properties": {
    "settings": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "capacity": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "total_slots": {"type": "integer", "minimum": 1, "maximum": 64},
            "startup_parallelism": {"type": "integer", "minimum": 1, "maximum": 64},
            "human": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "slots": {"type": "integer", "minimum": 0, "maximum": 64},
                "allow_borrowing": {"type": "boolean"},
                "accept_public": {"type": "boolean"}
              },
              "additionalProperties": false
            },
            "bot": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "slots": {"type": "integer", "minimum": 0, "maximum": 64},
                "target_active": {"type": "integer", "minimum": 0, "maximum": 64}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "inbound_challenges": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "accept_bots": {"type": "boolean"},
            "min_base": {"type": "integer", "minimum": 0, "maximum": 86400},
            "max_base": {"type": "integer", "minimum": 0, "maximum": 86400},
            "min_increment": {"type": "integer", "minimum": 0, "maximum": 300},
            "max_increment": {"type": "integer", "minimum": 0, "maximum": 300},
            "speeds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {"enum": ["ultraBullet", "bullet", "blitz", "rapid", "classical", "correspondence"]}
            },
            "modes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"enum": ["casual", "rated"]}
            }
          },
          "additionalProperties": false
        },
        "outbound_challenge": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "rated": {"type": "boolean"},
            "color": {"enum": ["random", "white", "black"]},
            "clock_limit": {"type": "integer", "minimum": 0, "maximum": 86400},
            "clock_increment": {"type": "integer", "minimum": 0, "maximum": 300}
          },
          "additionalProperties": false
        },
        "scheduler": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "enabled": {"type": "boolean"},
            "discovery_interval_seconds": {"type": "integer", "minimum": 15, "maximum": 3600},
            "challenge_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "reservation_retry_seconds": {"type": "integer", "minimum": 5, "maximum": 600},
            "challenge_timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 300},
            "first_move_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 600}
          },
          "additionalProperties": false
        },
        "opponent_selection": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "max_games_per_opponent_per_day": {"type": "integer", "minimum": 1, "maximum": 100},
            "timeout_cooldown_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
            "decline_cooldown_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
            "rating_target": {"type": "integer", "minimum": 400, "maximum": 4000},
            "rating_spread": {"type": "integer", "minimum": 50, "maximum": 2000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rated_confirmation": {"type": "string", "maxLength": 128},
    "outbound_confirmation": {"type": "string", "maxLength": 128}
  },
  "additionalProperties": false,
  "x-semantic-validation": [
    "capacity audience slots sum to total_slots",
    "bot target_active does not exceed bot slots",
    "minimum clock values do not exceed maximum clock values",
    "capacity changes require exact qualified evidence",
    "new rated and automatic outbound modes require exact confirmation values"
  ]
}
