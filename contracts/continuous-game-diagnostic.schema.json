{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uci_continuous_complete_game_diagnostic_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "producer",
    "authority",
    "binding",
    "configuration",
    "games",
    "resource_isolation",
    "failures",
    "completed",
    "completed_at"
  ],
