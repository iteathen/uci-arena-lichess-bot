      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "source_tree",
        "entrypoint",
        "source_files",
        "node_runtime",
        "node_version",
        "source_clean"
      ],
      "properties": {
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_tree": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "entrypoint": {
          "$ref": "#/$defs/file"
        },
        "source_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "maxItems": 128
        },
        "node_runtime": {
          "$ref": "#/$defs/file"
        },
        "node_version": {
          "type": "string"
        },
        "source_clean": {
          "type": "boolean"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic",
        "timing",
        "strength",
        "performance",
        "release",
        "retention"
      ],
      "properties": {
        "diagnostic": {
          "const": true
        },
        "timing": {
          "const": false
        },
        "strength": {
          "const": false
        },
        "performance": {
          "const": false
        },
        "release": {
          "const": false
        },
        "retention": {
          "const": false
        }
      }
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
